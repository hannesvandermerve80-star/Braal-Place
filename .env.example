# ---- Server ----
PORT=4000
NODE_ENV=development
# Long random string. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string
# Shared secret used to sign payment provider webhooks (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# Comma-separated list of allowed browser origins (dev client)
CLIENT_ORIGIN=http://localhost:5173
# SQLite file (relative to /server). Use :memory: for tests.
DATABASE_FILE=data/bekies.db
# Private uploads folder for seller verification documents
UPLOAD_DIR=uploads
# Seed demo users, orders and applications on first run (shows demo logins on the sign-in page)
DEMO_MODE=true

# ---- Public address (used in emails and payment return URLs) ----
# e.g. https://shop.yourdomain.co.za  (defaults to the first CLIENT_ORIGIN)
PUBLIC_URL=

# ---- Email via Resend (recommended) ----
# Create an API key at resend.com and verify your sending domain, then set both:
RESEND_API_KEY=
# MAIL_FROM must use your verified domain, e.g. "Bekies Braai Place <orders@yourdomain.co.za>"
# (If RESEND_API_KEY is set it is used instead of SMTP.)

# ---- Or email via any SMTP provider: Brevo, SendGrid, Mailgun, Postmark, Gmail app password…) ----
# Without SMTP_HOST, emails are only logged — set these before going live.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bekies Braai Place <no-reply@yourdomain.co.za>"

# ---- PayFast (South African payment gateway) ----
# When PAYFAST_MERCHANT_ID is set, checkout uses PayFast and demo payments are switched off.
# Use PAYFAST_SANDBOX=true while testing with sandbox credentials, false for live.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# ---- First administrator (used when DEMO_MODE=false and no admin exists yet) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
